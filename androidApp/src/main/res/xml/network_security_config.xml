<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9+ blocks cleartext (plain HTTP) traffic by default. The torrent player reads
    from its own loopback server (see LocalStreamServer), which is HTTP because it never
    leaves the device — there is nothing to negotiate TLS with on 127.0.0.1. This allows
    cleartext for the loopback address only, leaving every other host under the app's
    default (HTTPS-only) policy.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
