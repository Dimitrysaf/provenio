<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Televisions have no touchscreen and may be wired, so none of these is required. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:banner="@drawable/tv_banner_arctic_blue"
        android:icon="@mipmap/ic_launcher_arctic_blue"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_arctic_blue"
        android:localeConfig="@xml/locale_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Provenio">
        <activity
            android:exported="true"
            android:name="io.github.dimitrysaf.provenio.MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="provenio"
                    android:host="auth"
                    android:path="/simkl" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="provenio"
                    android:host="auth"
                    android:path="/trakt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="provenio" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="stremio" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconDefault"
            android:banner="@drawable/tv_banner_arctic_blue"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arctic_blue"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconArcticBlue"
            android:banner="@drawable/tv_banner_arctic_blue"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_arctic_blue"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.ArcticBlue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconOriginal"
            android:banner="@drawable/tv_banner_original"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.Original">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconEmerald"
            android:banner="@drawable/tv_banner_emerald"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_emerald"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.Emerald">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconRoseGold"
            android:banner="@drawable/tv_banner_rose_gold"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose_gold"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.RoseGold">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconCopper"
            android:banner="@drawable/tv_banner_copper"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_copper"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.Copper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.dimitrysaf.provenio.launcher.AppIconGraphite"
            android:banner="@drawable/tv_banner_graphite"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:label="@string/app_name"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Provenio.Splash.Graphite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="io.github.dimitrysaf.provenio.core.playback.PlayerNowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <receiver
            android:name="io.github.dimitrysaf.provenio.core.playback.PlayerNowPlayingActionReceiver"
            android:exported="false" />

        <receiver
            android:name="io.github.dimitrysaf.provenio.core.downloads.DownloadsNotificationActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
